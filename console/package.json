{
  "name": "vigil-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Vigil operator console — the surfacing layer (doc 10). The one place the three provenance classes meet, each still wearing its label.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
